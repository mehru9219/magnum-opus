# AI Provider API Keys
# At least one provider is required

# OpenAI (GPT-4, GPT-3.5 Turbo)
OPENAI_API_KEY=sk-...

# Anthropic (Claude 3.5 Sonnet, Claude 3 Opus, etc.)
ANTHROPIC_API_KEY=sk-ant-...

# Perplexity (Research-backed content generation)
PERPLEXITY_API_KEY=pplx-...

# Google Gemini (Gemini 1.5 Pro, Flash)
GOOGLE_GEMINI_API_KEY=...

# Redis Cache (Upstash - Optional but recommended)
# Reduces AI costs by 60-80% through caching
UPSTASH_REDIS_URL=https://...
UPSTASH_REDIS_TOKEN=...

# Convex Backend
CONVEX_DEPLOYMENT=...
NEXT_PUBLIC_CONVEX_URL=...

# Clerk Authentication
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_...
CLERK_SECRET_KEY=sk_...

# Stripe Payments
STRIPE_SECRET_KEY=sk_...
STRIPE_PUBLISHABLE_KEY=pk_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Inngest Background Jobs
INNGEST_EVENT_KEY=...
INNGEST_SIGNING_KEY=...

# Monitoring & Analytics (Production)
SENTRY_DSN=https://...
NEXT_PUBLIC_POSTHOG_KEY=phc_...
AXIOM_TOKEN=...

# AI Services Configuration (Optional)
AI_CACHE_TTL=86400              # Cache TTL in seconds (default: 24 hours)
AI_MAX_RETRIES=3                # Max retry attempts for failed requests
AI_ENABLE_FALLBACK=true         # Enable automatic model fallback
AI_LOG_LEVEL=info               # Log level: debug, info, warn, error
ENABLE_AI_CACHE=true            # Enable/disable AI response caching

# Environment
NODE_ENV=development            # development | production
NEXT_PUBLIC_APP_URL=http://localhost:3000
